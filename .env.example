# Placeholder environment variables for APIShield.
#
# Copy this file to ".env" on the machine where APIShield will run
# (the Kali Linux VM, next to main.py) and fill in the real values.
# Never commit the real .env file to version control.

# Base URL of the target API. Must be a literal loopback IP address;
# hostnames such as "localhost" are rejected (DNS-rebinding defence).
APISHIELD_BASE_URL=http://127.0.0.1:8888

# Bearer tokens for the two synthetic test accounts.
# Obtain these by signing in to the lab through its login endpoint.
APISHIELD_USER_A_TOKEN=
APISHIELD_USER_B_TOKEN=

# Resource identifiers (e.g. vehicle IDs) owned by each account.
# Used to build the differential test matrix B01-B05.
APISHIELD_USER_A_VEHICLE_ID=
APISHIELD_USER_B_VEHICLE_ID=
